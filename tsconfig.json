{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "jsx": "react-jsx",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "@/*": ["./src/*"],
      "demo/*": ["./demo/*"],
      "yuque-rich-text": ["./src/index.ts"],
      "yuque-rich-text/vue": ["./src/vue/index.ts"],
      "yuque-rich-text/react": ["./src/react/index.ts"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "types/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "demo/**/*.vue",
    "demo/**/*.ts",
    "demo/**/*.tsx"
  ],
  "exclude": ["node_modules", "lib", "dist"]
}
